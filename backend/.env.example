# Copy this to .env and fill in your values

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/househunt

# CORS — your Next.js frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-nextjs-app.vercel.app

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET_NAME=househunt-media
AWS_S3_REGION=af-south-1

# Africa's Talking SMS
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=HouseHunt